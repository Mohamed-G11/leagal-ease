
# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=legalease
POSTGRES_PASSWORD=change_me
POSTGRES_DB=legalease

# SQLAlchemy URL. Keep the +psycopg2 suffix: SQLAlchemy 2.1 defaults plain postgresql:// to psycopg v3.
DATABASE_URL=postgresql+psycopg2://legalease:change_me@localhost:5433/legalease

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- App ---
SECRET_KEY=change_me
GROQ_API_KEY=change_me
RESEND_API_KEY=

# RAG pipeline config, relative to the repo root
RAG_CONFIG=experiments/E1_hybrid_rag/config.yaml

# --- Model registry (MLflow on DagsHub). Leave empty to serve RAG_CONFIG ---
# https://dagshub.com/<user>/<repo>.mlflow, your DagsHub user name, and an access token as the password
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Langfuse tracing. Off unless both keys are set ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU, the default) or https://us.cloud.langfuse.com, as shown with your keys
LANGFUSE_BASE_URL=
# "true" also sends question, prompt and answer text. Deleting a conversation does not erase it from Langfuse.
LANGFUSE_CAPTURE_TEXT=

# Grafana (docker-compose): password of the 'admin' user. Grafana does not start without it.
GRAFANA_ADMIN_PASSWORD=
