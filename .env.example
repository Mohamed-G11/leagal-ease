
# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=legalease
POSTGRES_PASSWORD=change_me
POSTGRES_DB=legalease

# SQLAlchemy URL. Keep the +psycopg2 suffix: SQLAlchemy 2.1 defaults plain postgresql:// to psycopg v3.
DATABASE_URL=postgresql+psycopg2://legalease:change_me@localhost:5432/legalease

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- App ---
SECRET_KEY=change_me
GROQ_API_KEY=change_me
RESEND_API_KEY=